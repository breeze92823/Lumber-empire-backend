# Copy to .env (gitignored) for local development. None of these are
# required to run `npm start` -- every one degrades gracefully when unset.

# MongoDB connection string for player-progress persistence. Bloxity Legion
# hosting injects this per game+channel in deployed environments; leave unset
# locally to run with persistence disabled (progress lasts the connection only).
MONGODB_URI=

# Bloxity hosting injects BLOXITY_API_URL, BLOXITY_GAME_ID, BLOXITY_REPORT_TOKEN and
# MATCHMAKER_REPORT_URL. Without them: ids are trusted (outside production), and the
# room directory and trophy boards stay off.

# CORS allow-origin for deployed environments. Falls back to "*" when unset.
CLIENT_ORIGIN=

# HTTP port. Falls back to 2567 when unset.
PORT=2567
